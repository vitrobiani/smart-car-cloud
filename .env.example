# Copy to .env and adjust for local runs.
# DATABASE_URL is consumed by smart_car_project/database.py (sync psycopg2 URL).
# We don't own the schema — coordinate with smart_car_project maintainer.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carbrain

REDIS_URL=redis://localhost:6379/0

# Cloud LLM providers (not wired; leave blank for now)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local llama-server (OpenAI-compatible). Bring it up with ./run-local-llm.sh.
LLM_BASE_URL=http://127.0.0.1:8880/v1
LLM_MODEL=gemma
LLM_TIMEOUT_S=60

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
